{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jep.org/schemas/jep-event-0.7.schema.json",
  "title": "JEP Core 0.7 Event",
  "$comment": "Structural schema for JEP-Core-0.7. The Internet-Draft is normative. Cryptographic, trust-profile, acceptance-state, reference-resolution, and policy checks require a validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jep",
    "id",
    "verb",
    "who",
    "when",
    "what",
    "sig"
  ],
  "properties": {
    "jep": {
      "type": "string",
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\x00-\\x7F]+$"
    },
    "verb": {
      "type": "string",
      "enum": [
        "J",
        "D",
        "T",
        "V"
      ]
    },
    "who": {
      "type": "string",
      "minLength": 1
    },
    "when": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "what": {
      "$ref": "#/$defs/claim"
    },
    "aud": {
      "type": "string",
      "minLength": 1
    },
    "ref": {
      "$ref": "#/$defs/reference"
    },
    "ext": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      },
      "propertyNames": {
        "minLength": 1
      }
    },
    "ext_crit": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sig": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1
        }
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(?:sha256:[0-9a-f]{64}|(?!sha256:)[a-z0-9][a-z0-9-]*:[0-9a-f]+)(?![\\s\\S])"
    },
    "eventIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "who",
        "id"
      ],
      "properties": {
        "who": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reference": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "value": {},
            "hash": {
              "$ref": "#/$defs/digest"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "jep:event"
                  }
                },
                "required": [
                  "type"
                ]
              },
              "then": {
                "properties": {
                  "value": {
                    "$ref": "#/$defs/eventIdentity"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "claim": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verb": {
            "const": "D"
          }
        },
        "required": [
          "verb"
        ]
      },
      "then": {
        "properties": {
          "what": {
            "type": "object",
            "required": [
              "delegatee",
              "scope"
            ],
            "properties": {
              "delegatee": {
                "type": "string",
                "minLength": 1
              },
              "scope": {}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "T"
          }
        },
        "required": [
          "verb"
        ]
      },
      "then": {
        "required": [
          "ref"
        ],
        "properties": {
          "what": {
            "type": "object",
            "required": [
              "termination_scope"
            ],
            "properties": {
              "termination_scope": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "ref": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "V"
          }
        },
        "required": [
          "verb"
        ]
      },
      "then": {
        "required": [
          "ref"
        ],
        "properties": {
          "what": {
            "type": "object",
            "required": [
              "verification_scope",
              "result"
            ],
            "properties": {
              "verification_scope": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "result": {}
            }
          },
          "ref": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    }
  ]
}
