{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jep.org/schemas/jep-event-0.6.schema.json",
  "title": "JEP v0.6 Baseline Event",
  "$comment": "Structural seed for JEP-Core-0.6 and the repository's Ed25519/JWS/JCS baseline. The Internet-Draft is normative; cryptographic, trust-profile, replay, chain, and policy validation require a validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jep",
    "verb",
    "who",
    "when",
    "nonce",
    "sig"
  ],
  "properties": {
    "jep": {
      "type": "string",
      "const": "1"
    },
    "verb": {
      "type": "string",
      "enum": [
        "J",
        "D",
        "T",
        "V"
      ]
    },
    "who": {
      "type": "string",
      "minLength": 1
    },
    "when": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "what": {
      "$ref": "#/$defs/claim"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "aud": {
      "type": "string",
      "minLength": 1
    },
    "ref": {
      "$ref": "#/$defs/referenceOrNull"
    },
    "ext": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "ext_crit": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sig": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1
        }
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^(?:sha256:[0-9a-f]{64}|(?!sha256:)[a-z0-9][a-z0-9-]*:[0-9a-f]+)$"
    },
    "claim": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true,
          "properties": {
            "claim": {
              "type": "string",
              "minLength": 1
            },
            "subject": {},
            "scope": {},
            "result": {},
            "evidence": {},
            "context": {},
            "delegatee": {
              "type": "string",
              "minLength": 1
            },
            "constraints": {
              "type": "array"
            },
            "target": {},
            "termination_scope": {
              "type": "string",
              "minLength": 1
            },
            "verification_scope": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "reference": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "value": {},
            "hash": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      ]
    },
    "referenceOrNull": {
      "oneOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verb": {
            "const": "J"
          }
        },
        "required": [
          "verb"
        ]
      },
      "then": {
        "required": [
          "what"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "D"
          }
        },
        "required": [
          "verb"
        ]
      },
      "then": {
        "required": [
          "what",
          "ref"
        ],
        "properties": {
          "what": {
            "oneOf": [
              {
                "$ref": "#/$defs/digest"
              },
              {
                "type": "object",
                "required": [
                  "claim",
                  "delegatee",
                  "scope"
                ],
                "minProperties": 3,
                "additionalProperties": true,
                "properties": {
                  "claim": {
                    "type": "string",
                    "minLength": 1
                  },
                  "delegatee": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope": {
                    "not": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "T"
          }
        },
        "required": [
          "verb"
        ]
      },
      "then": {
        "required": [
          "what",
          "ref"
        ],
        "properties": {
          "what": {
            "oneOf": [
              {
                "$ref": "#/$defs/digest"
              },
              {
                "type": "object",
                "required": [
                  "claim",
                  "target",
                  "termination_scope"
                ],
                "minProperties": 3,
                "additionalProperties": true,
                "properties": {
                  "claim": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target": {
                    "not": {
                      "type": "null"
                    }
                  },
                  "termination_scope": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verb": {
            "const": "V"
          }
        },
        "required": [
          "verb"
        ]
      },
      "then": {
        "required": [
          "what",
          "ref"
        ],
        "properties": {
          "ref": {
            "$ref": "#/$defs/reference"
          },
          "what": {
            "oneOf": [
              {
                "$ref": "#/$defs/digest"
              },
              {
                "type": "object",
                "required": [
                  "verification_scope"
                ],
                "minProperties": 1,
                "additionalProperties": true,
                "properties": {
                  "verification_scope": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
